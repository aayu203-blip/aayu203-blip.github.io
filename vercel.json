{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap_index.xml", "permanent": true },
    { "source": "/news-sitemap.xml", "destination": "/sitemap_index.xml", "permanent": true },
    { "source": "/pages/hubs/brand-scania", "destination": "/scania/", "permanent": true },
    { "source": "/pages/hubs/brand-volvo", "destination": "/volvo/", "permanent": true },
    { "source": "/pages/hubs/brand-komatsu", "destination": "/komatsu/", "permanent": true },
    { "source": "/pages/hubs/brand-cat", "destination": "/cat/", "permanent": true },
    { "source": "/pages/hubs/brand-hitachi", "destination": "/hitachi/", "permanent": true },
    { "source": "/pages/hubs/brand-kobelco", "destination": "/kobelco/", "permanent": true },
    { "source": "/pages/hubs/brand-john-deere", "destination": "/john-deere/", "permanent": true },
    { "source": "/pages/hubs/:path*", "destination": "/", "permanent": true },
    { "source": "/pages/:path*", "destination": "/", "permanent": true },
    { "source": "/komatsu/bulldozer-parts/:path*", "destination": "/komatsu/", "permanent": true },
    { "source": "/komatsu/excavator-parts/:path*", "destination": "/komatsu/", "permanent": true },
    { "source": "/komatsu/mini-excavator-parts/:path*", "destination": "/komatsu/", "permanent": true },
    { "source": "/komatsu/wheel-loader-parts/:path*", "destination": "/komatsu/", "permanent": true },
    { "source": "/komatsu/travel-and-swing-motor-parts/:path*", "destination": "/komatsu/", "permanent": true },
    { "source": "/komatsu/belt-hose/:path*", "destination": "/komatsu/", "permanent": true },
    { "source": "/cat/belt-hose/:path*", "destination": "/cat/", "permanent": true },
    { "source": "/volvo/bulldozer-parts/:path*", "destination": "/volvo/", "permanent": true },
    { "source": "/volvo/air-drier-and-parts/:path*", "destination": "/volvo/", "permanent": true },
    { "source": "/volvo/air-systems/:path*", "destination": "/volvo/", "permanent": true },
    { "source": "/volvo/belts-pulleys/:path*", "destination": "/volvo/", "permanent": true },
    { "source": "/volvo/drivetrain/:path*", "destination": "/volvo/", "permanent": true },
    { "source": "/volvo/hose-pipe/:path*", "destination": "/volvo/", "permanent": true },
    { "source": "/volvo/seals-gaskets/:path*", "destination": "/volvo/", "permanent": true },
    { "source": "/volvo/shock-absorbers/:path*", "destination": "/volvo/", "permanent": true },
    { "source": "/volvo/wheel-parts/:path*", "destination": "/volvo/", "permanent": true },
    { "source": "/hitachi/belt-hose/:path*", "destination": "/hitachi/", "permanent": true },
    { "source": "/scania/air-systems/:path*", "destination": "/scania/", "permanent": true },
    { "source": "/scania/wheel-parts/:path*", "destination": "/scania/", "permanent": true },
    { "source": "/kobelco/belt-hose/:path*", "destination": "/kobelco/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/products/:path*", "destination": "/pages/products/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31556952; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google.com https://www.gstatic.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; frame-src https://www.google.com https://maps.google.com;"
        }
      ]
    }
  ]
}
